{
  "name": "billo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:compile && concurrently -k -n vite,electron \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "vite build --mode production && npm run electron:compile && electron-builder --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p electron/tsconfig.json --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "jsdom": "^27.4.0",
    "sass": "^1.108.0",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  },
  "main": "dist-electron/main.js",
  "description": "Billo desktop app",
  "author": "TamarCoder",
  "build": {
    "appId": "com.billo.app",
    "productName": "Billo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "public/icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance"
    },
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "public/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
